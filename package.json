{
  "name": "spec-exam-expo",
  "version": "1.0.0",
  "packageManager": "pnpm@11.15.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:tests",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:react": "jest --runInBand",
    "test": "pnpm test:unit && pnpm test:react",
    "test:unit:watch": "vitest",
    "test:react:watch": "jest --watch",
    "api:download": "tsx scripts/openapi/download.ts",
    "api:inspect": "tsx scripts/openapi/inspect.ts",
    "api:convert": "tsx scripts/openapi/convert.ts",
    "api:patch": "tsx scripts/openapi/patch.ts",
    "api:validate": "tsx scripts/openapi/validate.ts",
    "api:report": "tsx scripts/openapi/report.ts",
    "api:generate": "orval --config orval.config.ts",
    "api:refresh": "pnpm api:download && pnpm api:inspect && pnpm api:convert && pnpm api:patch && pnpm api:validate && pnpm api:report && pnpm api:generate",
    "api:check": "pnpm api:convert && pnpm api:patch && pnpm api:validate && pnpm api:report && pnpm api:generate && git diff --exit-code -- openapi/normalized openapi/reports src/shared/api/generated",
    "auth:capture-contract": "tsx scripts/auth/capture-contract.ts",
    "auth:analyze-fixture": "tsx scripts/auth/analyze-fixture.ts",
    "doctor": "npx expo-doctor",
    "validate:base": "pnpm typecheck && pnpm lint && pnpm test && pnpm doctor",
    "validate": "pnpm validate:base"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.10",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.9",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-router": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "js-md5": "^0.8.3",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-hook-form": "^7.54.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-webview": "13.16.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^30.0.0",
    "@types/js-md5": "^0.8.0",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~9.2.0",
    "jest": "^29.0.0",
    "jest-expo": "~57.0.3",
    "orval": "^7.0.0",
    "swagger2openapi": "^7.0.8",
    "tsx": "^4.0.0",
    "typescript": "~6.0.3",
    "vitest": "^3.0.0"
  }
}
