{
  "name": "spec-exam-expo",
  "version": "1.0.0",
  "packageManager": "pnpm@11.15.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:react": "jest --runInBand",
    "test": "pnpm test:unit && pnpm test:react",
    "test:unit:watch": "vitest",
    "test:react:watch": "jest --watch",
    "api:download": "tsx scripts/openapi/download.ts",
    "api:convert": "tsx scripts/openapi/convert.ts",
    "api:patch": "tsx scripts/openapi/patch.ts",
    "api:validate": "tsx scripts/openapi/validate.ts",
    "api:generate": "orval --config orval.config.ts",
    "api:check": "pnpm api:generate && git diff --exit-code src/shared/api/generated openapi/normalized",
    "api:refresh": "pnpm api:download && pnpm api:convert && pnpm api:patch && pnpm api:validate && pnpm api:generate",
    "doctor": "npx expo-doctor",
    "validate:base": "pnpm typecheck && pnpm lint && pnpm test && pnpm doctor",
    "validate": "pnpm validate:base"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@tanstack/react-query": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.10",
    "expo-clipboard": "~7.1.0",
    "expo-constants": "~17.1.0",
    "expo-font": "~13.3.0",
    "expo-image": "~2.2.0",
    "expo-linear-gradient": "~14.1.0",
    "expo-router": "~5.1.0",
    "expo-secure-store": "~14.1.0",
    "expo-splash-screen": "~0.30.0",
    "expo-status-bar": "~57.0.1",
    "jest-expo": "~57.0.3",
    "js-md5": "^0.8.3",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-hook-form": "^7.54.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.23.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.5.0",
    "react-native-webview": "13.13.5",
    "react-test-renderer": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-md5": "^0.8.0",
    "@types/react": "~19.2.2",
    "babel-jest": "^30.4.1",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~9.2.0",
    "jest": "^30.4.2",
    "orval": "^7.0.0",
    "react-native-worklets-core": "^1.6.3",
    "tsx": "^4.0.0",
    "typescript": "~6.0.3",
    "vitest": "^3.0.0"
  }
}
